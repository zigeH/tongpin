{
  "expo": {
    "name": "一起搭",
    "slug": "tongpin-blindbox",
    "scheme": "tongpin",
    "version": "0.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zigeh.tongpin",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zigeh.tongpin",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "选一张照片做成 3D 盲盒",
          "cameraPermission": "拍一样东西做成 3D 盲盒，或者和 3D 模型合影"
        }
      ],
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "选一张照片做成 3D 盲盒",
          "savePhotosPermission": "把你和 3D 模型的合影存进相册",
          "granularPermissions": ["photo"]
        }
      ],
      "expo-sharing",
      [
        "@reactvision/react-viro",
        {
          "ios": {
            "cameraUsagePermission": "拍一样东西做成 3D 盲盒，或者和 3D 模型合影",
            "microphoneUsagePermission": "AR 合影不录音；系统要求声明麦克风用途",
            "photosPermission": "选一张照片做成 3D 盲盒",
            "savephotosPermission": "把你和 3D 模型的合影存进相册"
          }
        }
      ]
    ],
    "owner": "yueshuchens-team",
    "extra": {
      "eas": {
        "projectId": "c8d04a11-5b39-4f99-8103-703429e6e3fd"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c8d04a11-5b39-4f99-8103-703429e6e3fd"
    }
  }
}
