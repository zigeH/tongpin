{
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ESNext",
    "lib": [
      "ES2022",
      "dom"
    ],
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "convex/**/*",
    "tests/**/*",
    "scripts/**/*",
    "vitest.config.ts"
  ],
  "exclude": [
    "convex/_generated"
  ]
}
